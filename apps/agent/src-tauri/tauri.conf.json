{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ErtePano Ajan",
  "version": "0.2.0",
  "identifier": "com.erte.pano.agent",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "img-src": "'self' http: https: data: blob:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi"
    ],
    "publisher": "Erte",
    "shortDescription": "Kurumsal ekran duyurulari",
    "longDescription": "ErtePano Ajan; IK, ISG ve IT duyurularini ekranda gosterir, acil durum yoklamasina yanit alir ve KVKK uyumlu IT envanteri gonderir.",
    "category": "Business",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "tr-TR"
      }
    }
  }
}
