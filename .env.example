# ErtePano sunucu ayarları — bu dosyayı ".env" adıyla kopyalayın. .env git'e girmez.

# PORT=4100
# PUBLIC_URL=https://pano.sirket.local
# SECURE_COOKIES=true
# DATA_DIR=C:\ErtePano\data

# ---- Active Directory / LDAP (LDAP_URL + LDAP_BASE_DN verilince açılır) ----
# Üretimde LDAPS (636) ya da LDAP_STARTTLS=true kullanın.
# LDAP_URL=ldaps://dc01.sirket.local:636
# LDAP_BASE_DN=DC=sirket,DC=local
# LDAP_BIND_DN=CN=svc-ertepano,OU=Servis Hesaplari,DC=sirket,DC=local
# LDAP_BIND_PASSWORD=
# LDAP_DOMAIN=SIRKET
# LDAP_STARTTLS=false
# LDAP_CA_FILE=C:\ErtePano\kurumsal-ca.pem
# LDAP_TLS_REJECT_UNAUTHORIZED=true
# Varsayılan filtre: (&(objectClass=user)(objectCategory=person)(sAMAccountName={{username}}))
# LDAP_USER_FILTER=

# Rol → AD grubu. CN adı (ErtePano-IK) ya da tam DN (iç içe grupları da çözer).
# LDAP_GROUP_ADMIN=ErtePano-Yonetici
# LDAP_GROUP_IT=ErtePano-IT
# LDAP_GROUP_ISG=ErtePano-ISG
# LDAP_GROUP_IK=ErtePano-IK
# LDAP_GROUP_VIEWER=ErtePano-Izleyici
# Hiçbir gruba üye olmayanlar: boş = giriş reddedilir, viewer = salt okur
# LDAP_DEFAULT_ROLE=
